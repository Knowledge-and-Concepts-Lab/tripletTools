<%
# batchtools/future.batchtools HTCondor cluster template.
#
# This is the same template shown in the "HTCondor cluster" section of the
# embedding_vignette, extended so request_cpus/request_memory/request_disk
# can be set per plan() call via `resources = list(...)` instead of being
# hardcoded. Falls back to the vignette's original defaults (1 CPU, 4GB
# memory, 2GB disk) if resources are not supplied.
#
# One-time setup: copy this file to your HTCondor submit node (e.g. as
# ~/.batchtools.condor.tmpl) and adjust anything site-specific -- in
# particular, every execute node HTCondor matches this job to must already
# have R, tripletTools, and the `triplet-embeddings` conda environment
# installed. If your CHTC pool does not have that pre-installed everywhere,
# add a `requirements` line to target nodes that do, or switch to a
# container-based (Apptainer/Docker) universe -- see the vignette.
-%>
universe     = vanilla
executable   = <%= file.path(R.home("bin"), "Rscript") %>
arguments    = -e 'batchtools::doJobCollection("$(job.collection)")'

transfer_input_files  = $(job.collection)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

request_cpus   = <%= if (!is.null(resources$request_cpus))   resources$request_cpus   else 1 %>
request_memory = <%= if (!is.null(resources$request_memory)) resources$request_memory else "4GB" %>
request_disk   = <%= if (!is.null(resources$request_disk))   resources$request_disk   else "2GB" %>

log    = $(log)
output = $(output)
error  = $(error)

queue
